{
  "name": "claude-youtube-connector",
  "version": "1.0.3",
  "description": "MCP server + Claude Code plugin: YouTube analytics, video management and scheduled posting with browser OAuth.",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "claude-youtube-mcp": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "login": "node server/cli-login.js",
    "test": "npm run build && node --test test/*.test.js",
    "build": "esbuild server/index.js --bundle --platform=node --format=esm --target=node18 --outfile=dist/server.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --log-level=warning"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
